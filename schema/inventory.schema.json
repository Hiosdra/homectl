{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "machines"],
  "properties": {
    "version": { "const": 1 },
    "machines": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,62}$" },
      "additionalProperties": { "$ref": "#/definitions/machine" }
    },
    "providers": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,62}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "url", "node", "token_id", "auth"],
        "properties": {
          "type": { "const": "proxmox" },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s/@]+(?::[0-9]+)?/?$"
          },
          "node": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]*$" },
          "token_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]+@[a-zA-Z0-9._-]+![a-zA-Z0-9._-]+$"
          },
          "auth": { "$ref": "#/definitions/auth" }
        }
      }
    }
  },
  "definitions": {
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "local-ssh-agent",
            "bitwarden-ssh-agent",
            "bitwarden-agent-access"
          ]
        },
        "socket": { "type": "string", "pattern": "^/[^\\r\\n\\u0000]+$" },
        "item_id": { "type": "string", "pattern": "^[a-zA-Z0-9-]{1,100}$" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "bitwarden-agent-access" } }
          },
          "then": { "required": ["item_id"] },
          "else": { "not": { "required": ["item_id"] } }
        }
      ]
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "transport", "access"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "transport": { "enum": ["local", "ssh"] },
        "access": { "enum": ["observe", "user", "sudo-approved", "full"] },
        "enforcement": { "enum": ["advisory", "sudoers"] },
        "caution": {
          "type": "array",
          "items": { "type": "string", "maxLength": 1000 }
        },
        "ssh_alias": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "address": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9.:-]*$"
        },
        "user": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "auth": { "$ref": "#/definitions/auth" },
        "sudo_allow": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "transport": { "const": "ssh" } } },
          "then": { "required": ["ssh_alias", "address", "user", "auth"] }
        }
      ]
    }
  }
}
