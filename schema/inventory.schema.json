{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "machines"],
  "properties": {
    "version": {
      "const": 1
    },
    "machines": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/machine"
      }
    },
    "providers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "host", "node"],
        "properties": {
          "type": {
            "const": "proxmox"
          },
          "host": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "node": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]*$"
          }
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ttl", "database"],
      "properties": {
        "ttl": {
          "type": "string",
          "pattern": "^(until-reboot|[1-9][0-9]{0,6}[smhd])$"
        },
        "database": {
          "type": "string",
          "pattern": "^/[^\\r\\n\\u0000]+\\.kdbx$"
        }
      }
    }
  },
  "definitions": {
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "socket", "entry", "public_key"],
      "properties": {
        "type": {
          "const": "keepassxc"
        },
        "socket": {
          "type": "string",
          "pattern": "^/[^\\r\\n\\u0000]+$"
        },
        "entry": {
          "type": "string",
          "pattern": "^homectl-[a-z][a-z0-9-]{0,62}$"
        },
        "public_key": {
          "type": "string",
          "pattern": "^/[^\\r\\n\\u0000]+\\.pub$"
        }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "transport", "access"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "transport": {
          "enum": ["local", "ssh"]
        },
        "access": {
          "enum": ["observe", "user", "sudo-approved", "full"]
        },
        "enforcement": {
          "enum": ["advisory", "sudoers"]
        },
        "caution": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "ssh_alias": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "address": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9.:-]*$"
        },
        "user": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,31}$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "auth": {
          "$ref": "#/definitions/auth"
        },
        "sudo_allow": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "const": "ssh"
              }
            }
          },
          "then": {
            "required": ["ssh_alias", "address", "user", "auth"]
          }
        }
      ]
    }
  }
}
