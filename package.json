{
  "name": "homectl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "homectl": "src/cli/main.ts"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts schema package.json tsconfig.json biome.json",
    "format": "biome check --write src tests scripts schema package.json tsconfig.json biome.json",
    "check": "bun run typecheck && bun run lint && bun test",
    "test:ui": "bun scripts/ui-smoke.ts"
  },
  "dependencies": {
    "ajv": "8.18.0",
    "hash-wasm": "4.12.0",
    "kdbxweb": "2.1.1",
    "multicast-dns": "7.2.5",
    "secure-remote-password": "0.3.1",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@playwright/test": "1.64.0",
    "@types/bun": "1.3.10",
    "@types/multicast-dns": "7.2.4",
    "typescript": "5.9.3"
  }
}
