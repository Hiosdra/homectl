{
  "name": "homectl",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "home-ctl": "src/cli/main.ts"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "test": "bun test",
    "build:panel": "bun scripts/build-panel.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bun scripts/check-file-length.ts && biome check src tests scripts schema package.json tsconfig.json biome.json",
    "format": "biome check --write src tests scripts schema package.json tsconfig.json biome.json",
    "check": "bun run typecheck && bun run lint && bun test",
    "test:ui": "bun scripts/ui-smoke.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "ajv": "8.18.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hash-wasm": "4.12.0",
    "kdbxweb": "2.1.1",
    "lucide-react": "1.72.0",
    "multicast-dns": "7.2.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "secure-remote-password": "0.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@playwright/test": "1.64.0",
    "@types/bun": "1.4.4",
    "@types/multicast-dns": "7.2.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
